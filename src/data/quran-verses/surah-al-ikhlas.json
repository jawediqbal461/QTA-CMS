{"number":112,"slug":"surah-al-ikhlas","nameArabic":"سُورَةُ الإِخۡلَاصِ","nameEnglish":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"numberInSurah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","translation":"Say, \"He is Allah, [who is] One,"},{"numberInSurah":2,"arabic":"ٱللَّهُ ٱلصَّمَدُ","translation":"Allah, the Eternal Refuge."},{"numberInSurah":3,"arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translation":"He neither begets nor is born,"},{"numberInSurah":4,"arabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translation":"Nor is there to Him any equivalent.\""}]}