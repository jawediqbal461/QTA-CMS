# Postgres container (docker-compose.yml)
POSTGRES_USER=qta
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=qta_cms

# Prisma connects to the container via the host-bound port (127.0.0.1:55432)
DATABASE_URL="postgresql://qta:change-me-to-a-long-random-value@127.0.0.1:55432/qta_cms?schema=public"

# API server
PORT=4000
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=7d
NODE_ENV=production

# Comma-separated list of origins allowed to call this API (the deployed frontend)
CORS_ORIGIN=https://new.qurantutorsacademy.com

# Email verification and lesson notifications (SMTP - any provider works:
# Hestia's own mail server for this domain, Gmail, your host's SMTP, etc.)
PUBLIC_APP_URL=https://new.qurantutorsacademy.com
MAIL_FROM="Quran Tutors Academy <notifications@qurantutorsacademy.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
