// QTA CMS backend data model (Phase 1 MVP)
// See PROJECT_PLAN.md "Architecture and data" for the source requirements:
// accounts, academy memberships, guardian-student links, tutor profiles,
// availability, bookings, lesson sessions, progress entries, curriculum,
// content revisions, and audit events — all scoped by academy_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  PLATFORM_ADMIN
  ACADEMY_ADMIN
  TUTOR
  GUARDIAN
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TutorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  BOOKED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum CurriculumStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum RequestStatus {
  PENDING
  MATCHED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ResourceAccessLevel {
  PUBLIC
  ENROLLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REFUNDED
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

model Academy {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  createdAt   DateTime             @default(now())
  memberships AcademyMembership[]
  tutors      TutorProfile[]
  bookings    Booking[]
  curricula   Curriculum[]
  auditEvents AuditEvent[]
  learningRequests LearningRequest[]
  payments         PilotPayment[]
  courses          Course[]
  blogPosts        BlogPost[]
  courseEnrollments CourseEnrollment[]
  liveClasses      LiveClass[]

  @@map("academies")
}

model Account {
  id           String   @id @default(uuid())
  email        String   @unique
  emailVerifiedAt DateTime?
  passwordHash String
  fullName     String
  phone        String?
  country      String?
  city         String?
  address      String?
  avatar       String?
  timeZone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    AcademyMembership[]
  tutorProfile   TutorProfile?
  guardianLinks  GuardianStudentLink[] @relation("GuardianLinks")
  studentLinks   GuardianStudentLink[] @relation("StudentLinks")
  bookingsAsStudent Booking[]          @relation("StudentBookings")
  progressRecorded  ProgressEntry[]    @relation("ProgressRecordedBy")
  progressOf        ProgressEntry[]    @relation("ProgressOfStudent")
  auditEvents    AuditEvent[]
  notifications    PortalNotification[]
  guardianRequests LearningRequest[] @relation("GuardianRequests")
  studentRequests  LearningRequest[] @relation("StudentRequests")
  adminAssignments LearningRequest[] @relation("AdminAssignments")
  createdResources Resource[]        @relation("ResourceCreatedBy")
  payerPayments    PilotPayment[]    @relation("PayerPayments")
  confirmerPayments PilotPayment[]   @relation("ConfirmerPayments")
  reviewedCourses  Course[]          @relation("CourseReviewer")
  reviewsAuthored  TutorReview[]     @relation("ReviewsAuthored")
  messagesSent     Message[]         @relation("MessagesSent")
  messagesReceived Message[]         @relation("MessagesReceived")
  enrollmentsMade   CourseEnrollment[] @relation("EnrollmentsMade")
  enrollmentsAsStudent CourseEnrollment[] @relation("EnrollmentsAsStudent")
  liveMemberships     LiveClassMember[] @relation("LiveMemberStudent")
  liveEnrollmentsMade LiveClassMember[] @relation("LiveMemberEnroller")

  @@map("accounts")
}

model PortalNotification {
  id           String   @id @default(uuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  academyId    String
  bookingId    String?
  kind         String
  title        String
  message      String
  visibleAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  readAt       DateTime?
  emailedAt    DateTime?
  nextAttempt  DateTime @default(now())
  attempts     Int      @default(0)
  cancelledAt  DateTime?

  @@index([accountId, academyId, visibleAt])
  @@index([bookingId, kind])
  @@index([nextAttempt])
  @@map("portal_notifications")
}

model AcademyMembership {
  id        String           @id @default(uuid())
  academyId String
  academy   Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  accountId String
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      AccountRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  @@unique([academyId, accountId])
  @@map("academy_memberships")
}

model GuardianStudentLink {
  id         String   @id @default(uuid())
  guardianId String
  guardian   Account  @relation("GuardianLinks", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId  String
  student    Account  @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([guardianId, studentId])
  @@map("guardian_student_links")
}

model TutorProfile {
  accountId       String               @id
  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  academyId       String
  academy         Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  specialties     String[]
  experienceYears Int
  bio             String?
  qualifications  String?
  hourlyRate      Decimal              @db.Decimal(10, 2)
  languages       String[]
  approvalStatus  TutorApprovalStatus  @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]          @relation("TutorBookings")
  assignments       LearningRequest[]  @relation("TutorAssignments")
  courses           Course[]           @relation("TutorCourses")
  reviews           TutorReview[]
  liveClasses       LiveClass[]        @relation("TutorLiveClasses")

  @@map("tutor_profiles")
}

model AvailabilitySlot {
  id        String       @id @default(uuid())
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [accountId], onDelete: Cascade)
  weekday   Int // 0 = Sunday .. 6 = Saturday, interpreted in `timeZone`
  startTime String // "09:00"
  endTime   String // "10:00"
  timeZone  String // IANA tz, e.g. "Asia/Karachi"
  createdAt DateTime     @default(now())

  @@index([tutorId, weekday])
  @@map("availability_slots")
}

// PostgreSQL exclusion constraints in migration 0002 protect active
// tutor and student intervals, including overlapping starts.
model Booking {
  id              String        @id @default(uuid())
  academyId       String
  academy         Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  tutorId         String
  tutor           TutorProfile  @relation("TutorBookings", fields: [tutorId], references: [accountId])
  studentId       String
  student         Account       @relation("StudentBookings", fields: [studentId], references: [id])
  scheduledAtUtc  DateTime
  durationMinutes Int           @default(45)
  status          BookingStatus @default(BOOKED)
  meetingUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lessonSession LessonSession?
  progressEntry ProgressEntry?
  payments      PilotPayment[]  @relation("BookingPayments")

  @@index([studentId, scheduledAtUtc])
  @@map("bookings")
}

model LessonSession {
  id         String    @id @default(uuid())
  bookingId  String    @unique
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startedAt  DateTime?
  endedAt    DateTime?
  tutorNotes String?
  createdAt  DateTime  @default(now())

  @@map("lesson_sessions")
}

model ProgressEntry {
  id               String   @id @default(uuid())
  bookingId        String?  @unique
  booking          Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  studentId        String
  student          Account  @relation("ProgressOfStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recordedById     String
  recordedBy       Account  @relation("ProgressRecordedBy", fields: [recordedById], references: [id])
  recordedAt       DateTime @default(now())
  currentBook      String
  currentChapter   String
  currentVerse     Int?     @default(0)
  tajweedScore     Int?
  hifzPercent      Decimal? @db.Decimal(5, 2)
  notes            String?

  @@index([studentId, recordedAt])
  @@map("progress_entries")
}

model Curriculum {
  id          String            @id @default(uuid())
  academyId   String
  academy     Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title       String
  program     String
  level       String
  status      CurriculumStatus  @default(DRAFT)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  revisions ContentRevision[]

  @@map("curricula")
}

model ContentRevision {
  id            String     @id @default(uuid())
  curriculumId  String
  curriculum    Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  version       Int
  payload       Json
  submittedById String
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime   @default(now())

  @@unique([curriculumId, version])
  @@map("content_revisions")
}

// Append-only. Never updated or deleted by application code.
model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  academyId  String?
  academy    Academy? @relation(fields: [academyId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([academyId, createdAt])
  @@map("audit_events")
}

model Resource {
  id          String              @id @default(uuid())
  title       String
  description String?
  program     String
  level       String
  language    String
  format      String
  url         String
  accessLevel ResourceAccessLevel @default(PUBLIC)
  published   Boolean             @default(false)
  authorName  String?
  createdById String?
  createdBy   Account?            @relation("ResourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([program, level, language, published])
  @@map("resources")
}

model PilotPayment {
  id            String        @id @default(uuid())
  academyId     String
  academy       Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  bookingId     String?
  booking       Booking?      @relation("BookingPayments", fields: [bookingId], references: [id], onDelete: SetNull)
  payerId       String
  payer         Account       @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  method        String
  reference     String?
  notes         String?
  status        PaymentStatus @default(PENDING)
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   Account?      @relation("ConfirmerPayments", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([academyId, status, createdAt])
  @@index([bookingId])
  @@index([payerId])
  @@map("pilot_payments")
}

model Course {
  id             String       @id @default(uuid())
  academyId      String
  academy        Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  tutorId        String
  tutor          TutorProfile @relation("TutorCourses", fields: [tutorId], references: [accountId], onDelete: Cascade)
  title          String
  description    String?
  program        String
  level          String
  language       String
  format         String
  durationWeeks  Int?
  prerequisites  String?
  outcomes       String?
  priceAmount    Decimal?     @db.Decimal(10, 2)
  priceCurrency  String       @default("USD")
  status         CourseStatus @default(DRAFT)
  reviewNote     String?
  reviewedById   String?
  reviewedBy     Account?     @relation("CourseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  modules CourseModule[]
  enrollments CourseEnrollment[]

  @@index([academyId, status, program])
  @@index([tutorId])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String?
  createdAt   DateTime @default(now())

  @@index([courseId, position])
  @@map("course_modules")
}

model TutorReview {
  id        String       @id @default(uuid())
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [accountId], onDelete: Cascade)
  authorId  String
  author    Account      @relation("ReviewsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime     @default(now())

  @@unique([tutorId, authorId])
  @@index([tutorId, createdAt])
  @@map("tutor_reviews")
}

model Message {
  id        String   @id @default(uuid())
  academyId String
  fromId    String
  from      Account  @relation("MessagesSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Account  @relation("MessagesReceived", fields: [toId], references: [id], onDelete: Cascade)
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([academyId, fromId, createdAt])
  @@index([academyId, toId, createdAt])
  @@map("messages")
}

model DemoRoom {
  id          String   @id @default(uuid())
  title       String
  description String?
  roomSlug    String   @unique
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("demo_rooms")
}

model TajweedQuizResult {
  id        String   @id @default(uuid())
  name      String?
  email     String?
  score     Int
  maxScore  Int
  answers   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("tajweed_quiz_results")
}

model LearningRequest {
  id              String        @id @default(uuid())
  academyId       String
  academy         Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  guardianId      String
  guardian        Account       @relation("GuardianRequests", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId       String
  student         Account       @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  program         String
  level           String
  preferredLang   String
  budgetMax       Decimal?      @db.Decimal(10, 2)
  notes           String?
  status          RequestStatus @default(PENDING)
  assignedTutorId String?
  assignedTutor   TutorProfile? @relation("TutorAssignments", fields: [assignedTutorId], references: [accountId])
  assignedAt      DateTime?
  assignedById    String?
  assignedBy      Account?      @relation("AdminAssignments", fields: [assignedById], references: [id])
  tutorResponse   String?
  respondedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([academyId, status, createdAt])
  @@index([guardianId])
  @@index([assignedTutorId])
  @@map("learning_requests")
}

model BlogPost {
  id             String   @id @default(uuid())
  academyId      String
  academy        Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  excerpt        String
  content        String
  author         String
  coverImage     String
  status         String   @default("Draft")
  publishedAt    DateTime @default(now())
  tags           String[]
  seoTitle       String?
  seoDescription String?
  seoImage       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([academyId, slug])
  @@index([academyId, status, publishedAt])
  @@map("blog_posts")
}

// The Quran text itself ships with the app (src/data/quran-verses). A row here
// overrides individual fields for one surah on the public site.
model QuranSurahOverride {
  number                 Int      @id
  nameArabic             String?
  nameEnglish            String?
  englishNameTranslation String?
  revelationType         String?
  audioUrl               String?
  seoTitle               String?
  seoDescription         String?
  ayahs                  Json?
  updatedAt              DateTime @updatedAt

  @@map("quran_surah_overrides")
}

model QuranJuz {
  number      Int      @id
  nameArabic  String
  nameEnglish String
  startInfo   String
  updatedAt   DateTime @updatedAt

  @@map("quran_juz")
}

model CourseEnrollment {
  id         String           @id @default(uuid())
  academyId  String
  academy    Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledById String
  enrolledBy Account          @relation("EnrollmentsMade", fields: [enrolledById], references: [id], onDelete: Cascade)
  studentId  String
  student    Account          @relation("EnrollmentsAsStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([courseId, studentId])
  @@index([academyId, status, createdAt])
  @@index([enrolledById])
  @@map("course_enrollments")
}

model LiveClass {
  id              String       @id @default(uuid())
  academyId       String
  academy         Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  tutorId         String
  tutor           TutorProfile @relation("TutorLiveClasses", fields: [tutorId], references: [accountId], onDelete: Cascade)
  title           String
  description     String?
  program         String
  level           String
  language        String
  seats           Int
  durationMinutes Int
  status          String       @default("PENDING")
  reviewNote      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions LiveClassSession[]
  members  LiveClassMember[]

  @@index([academyId, status])
  @@index([tutorId])
  @@map("live_classes")
}

model LiveClassSession {
  id              String    @id @default(uuid())
  classId         String
  liveClass       LiveClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  durationMinutes Int
  status          String    @default("SCHEDULED")
  createdAt       DateTime  @default(now())

  @@index([classId, startsAt])
  @@index([startsAt])
  @@map("live_class_sessions")
}

model LiveClassMember {
  id           String    @id @default(uuid())
  classId      String
  liveClass    LiveClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId    String
  student      Account   @relation("LiveMemberStudent", fields: [studentId], references: [id], onDelete: Cascade)
  enrolledById String
  enrolledBy   Account   @relation("LiveMemberEnroller", fields: [enrolledById], references: [id], onDelete: Cascade)
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())

  @@unique([classId, studentId])
  @@index([enrolledById])
  @@map("live_class_members")
}

model MistakeLog {
  id           String   @id @default(uuid())
  academyId    String
  roomKey      String
  studentId    String?
  recordedById String
  type         String
  description  String
  severity     String
  createdAt    DateTime @default(now())

  @@index([roomKey, createdAt])
  @@index([studentId, createdAt])
  @@map("mistake_logs")
}

model LiveRecording {
  id          String   @id @default(uuid())
  academyId   String
  roomKey     String
  tutorId     String
  title       String
  filePath    String
  sizeBytes   Int      @default(0)
  durationSec Int      @default(0)
  status      String   @default("RECORDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roomKey, createdAt])
  @@index([academyId, createdAt])
  @@map("live_recordings")
}
