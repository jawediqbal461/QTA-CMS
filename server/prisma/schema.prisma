// QTA CMS backend data model (Phase 1 MVP)
// See PROJECT_PLAN.md "Architecture and data" for the source requirements:
// accounts, academy memberships, guardian-student links, tutor profiles,
// availability, bookings, lesson sessions, progress entries, curriculum,
// content revisions, and audit events — all scoped by academy_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  PLATFORM_ADMIN
  ACADEMY_ADMIN
  TUTOR
  GUARDIAN
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TutorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  BOOKED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum CurriculumStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum RequestStatus {
  PENDING
  MATCHED
  ACCEPTED
  DECLINED
  CANCELLED
}

model Academy {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  createdAt   DateTime             @default(now())
  memberships AcademyMembership[]
  tutors      TutorProfile[]
  bookings    Booking[]
  curricula   Curriculum[]
  auditEvents AuditEvent[]
  learningRequests LearningRequest[]

  @@map("academies")
}

model Account {
  id           String   @id @default(uuid())
  email        String   @unique
  emailVerifiedAt DateTime?
  passwordHash String
  fullName     String
  timeZone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    AcademyMembership[]
  tutorProfile   TutorProfile?
  guardianLinks  GuardianStudentLink[] @relation("GuardianLinks")
  studentLinks   GuardianStudentLink[] @relation("StudentLinks")
  bookingsAsStudent Booking[]          @relation("StudentBookings")
  progressRecorded  ProgressEntry[]    @relation("ProgressRecordedBy")
  progressOf        ProgressEntry[]    @relation("ProgressOfStudent")
  auditEvents    AuditEvent[]
  notifications    PortalNotification[]
  guardianRequests LearningRequest[] @relation("GuardianRequests")
  studentRequests  LearningRequest[] @relation("StudentRequests")
  adminAssignments LearningRequest[] @relation("AdminAssignments")

  @@map("accounts")
}

model PortalNotification {
  id           String   @id @default(uuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  academyId    String
  bookingId    String?
  kind         String
  title        String
  message      String
  visibleAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  readAt       DateTime?
  emailedAt    DateTime?
  nextAttempt  DateTime @default(now())
  attempts     Int      @default(0)
  cancelledAt  DateTime?

  @@index([accountId, academyId, visibleAt])
  @@index([bookingId, kind])
  @@index([nextAttempt])
  @@map("portal_notifications")
}

model AcademyMembership {
  id        String           @id @default(uuid())
  academyId String
  academy   Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  accountId String
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      AccountRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  @@unique([academyId, accountId])
  @@map("academy_memberships")
}

model GuardianStudentLink {
  id         String   @id @default(uuid())
  guardianId String
  guardian   Account  @relation("GuardianLinks", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId  String
  student    Account  @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([guardianId, studentId])
  @@map("guardian_student_links")
}

model TutorProfile {
  accountId       String               @id
  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  academyId       String
  academy         Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  specialties     String[]
  experienceYears Int
  bio             String?
  qualifications  String?
  hourlyRate      Decimal              @db.Decimal(10, 2)
  languages       String[]
  approvalStatus  TutorApprovalStatus  @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]          @relation("TutorBookings")
  assignments       LearningRequest[]  @relation("TutorAssignments")

  @@map("tutor_profiles")
}

model AvailabilitySlot {
  id        String       @id @default(uuid())
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [accountId], onDelete: Cascade)
  weekday   Int // 0 = Sunday .. 6 = Saturday, interpreted in `timeZone`
  startTime String // "09:00"
  endTime   String // "10:00"
  timeZone  String // IANA tz, e.g. "Asia/Karachi"
  createdAt DateTime     @default(now())

  @@index([tutorId, weekday])
  @@map("availability_slots")
}

// PostgreSQL exclusion constraints in migration 0002 protect active
// tutor and student intervals, including overlapping starts.
model Booking {
  id              String        @id @default(uuid())
  academyId       String
  academy         Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  tutorId         String
  tutor           TutorProfile  @relation("TutorBookings", fields: [tutorId], references: [accountId])
  studentId       String
  student         Account       @relation("StudentBookings", fields: [studentId], references: [id])
  scheduledAtUtc  DateTime
  durationMinutes Int           @default(45)
  status          BookingStatus @default(BOOKED)
  meetingUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lessonSession LessonSession?
  progressEntry ProgressEntry?

  @@index([studentId, scheduledAtUtc])
  @@map("bookings")
}

model LessonSession {
  id         String    @id @default(uuid())
  bookingId  String    @unique
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startedAt  DateTime?
  endedAt    DateTime?
  tutorNotes String?
  createdAt  DateTime  @default(now())

  @@map("lesson_sessions")
}

model ProgressEntry {
  id               String   @id @default(uuid())
  bookingId        String?  @unique
  booking          Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  studentId        String
  student          Account  @relation("ProgressOfStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recordedById     String
  recordedBy       Account  @relation("ProgressRecordedBy", fields: [recordedById], references: [id])
  recordedAt       DateTime @default(now())
  currentBook      String
  currentChapter   String
  currentVerse     Int?     @default(0)
  tajweedScore     Int?
  hifzPercent      Decimal? @db.Decimal(5, 2)
  notes            String?

  @@index([studentId, recordedAt])
  @@map("progress_entries")
}

model Curriculum {
  id          String            @id @default(uuid())
  academyId   String
  academy     Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title       String
  program     String
  level       String
  status      CurriculumStatus  @default(DRAFT)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  revisions ContentRevision[]

  @@map("curricula")
}

model ContentRevision {
  id            String     @id @default(uuid())
  curriculumId  String
  curriculum    Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  version       Int
  payload       Json
  submittedById String
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime   @default(now())

  @@unique([curriculumId, version])
  @@map("content_revisions")
}

// Append-only. Never updated or deleted by application code.
model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  academyId  String?
  academy    Academy? @relation(fields: [academyId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([academyId, createdAt])
  @@map("audit_events")
}

model LearningRequest {
  id              String        @id @default(uuid())
  academyId       String
  academy         Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  guardianId      String
  guardian        Account       @relation("GuardianRequests", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId       String
  student         Account       @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  program         String
  level           String
  preferredLang   String
  budgetMax       Decimal?      @db.Decimal(10, 2)
  notes           String?
  status          RequestStatus @default(PENDING)
  assignedTutorId String?
  assignedTutor   TutorProfile? @relation("TutorAssignments", fields: [assignedTutorId], references: [accountId])
  assignedAt      DateTime?
  assignedById    String?
  assignedBy      Account?      @relation("AdminAssignments", fields: [assignedById], references: [id])
  tutorResponse   String?
  respondedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([academyId, status, createdAt])
  @@index([guardianId])
  @@index([assignedTutorId])
  @@map("learning_requests")
}
